@model IncomeStatementDto

@{
    ViewData["Title"] = "Kết quả kinh doanh (B02-DN)";
}

<h1>Kết quả kinh doanh (B02-DN)</h1>

<div class="row">
    <div class="col-md-6">
        <h4>Doanh thu</h4>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Nhóm</th>
                    <th class="text-end">Tổng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Revenue.Any())
                {
                    @foreach (var item in Model.Revenue)
                    {
                        <tr>
                            <td>@item.GroupName</td>
                            <td class="text-end">@item.Total.ToString("N0") @item.Currency</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-6">
        <h4>Chi phí</h4>
        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Nhóm</th>
                    <th class="text-end">Tổng</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Expenses.Any())
                {
                    @foreach (var item in Model.Expenses)
                    {
                        <tr>
                            <td>@item.GroupName</td>
                            <td class="text-end">@item.Total.ToString("N0") @item.Currency</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="2" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <h4>Lợi nhuận ròng: <span class="text-success">@Model.NetIncome.ToString("N0") @Model.Currency</span></h4>
</div>
