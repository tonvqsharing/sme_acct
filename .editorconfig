root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 120
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# File-scoped namespaces are non-negotiable (enforced at build via EnforceCodeStyleInBuild)
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_constructors = when_on_single_line:silent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Analyzer severity overrides
dotnet_diagnostic.IDE0005.severity = suggestion # build-time IDE0005 needs GenerateDocumentationFile=true (Roslyn #41640) — keep docs off
dotnet_diagnostic.IDE0008.severity = suggestion
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.CS1591.severity = none       # missing XML doc comments (docs not generated)

[*.{xml,json,yml,yaml,props,targets,slnx}]
indent_style = space
indent_size = 2
tab_width = 2

[*.{md,sh,ps1}]
indent_style = space
indent_size = 2
tab_width = 2